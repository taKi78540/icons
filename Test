let
    Source = #"lecomptoir allvisits_181124",

    ColonnesUtiles = Table.SelectColumns(
        Source,
        {"cdspp_ritmlist"}
    ),

    FiltrerRITMNonVides = Table.SelectRows(
        ColonnesUtiles,
        each [cdspp_ritmlist] <> null
            and Text.Trim(Text.From([cdspp_ritmlist])) <> ""
    ),

    AjoutListeEquipements = Table.AddColumn(
        FiltrerRITMNonVides,
        "ListeEquipements",
        each List.Split(
            Text.Split(Text.From([cdspp_ritmlist]), ";"),
            2
        )
    ),

    DevelopperListeEquipements = Table.ExpandListColumn(
        AjoutListeEquipements,
        "ListeEquipements"
    ),

    AjoutTypeEquipement = Table.AddColumn(
        DevelopperListeEquipements,
        "TypeEquipement",
        each try Text.Trim(Text.From([ListeEquipements]{0})) otherwise null,
        type text
    ),

    AjoutRITM = Table.AddColumn(
        AjoutTypeEquipement,
        "RITM",
        each try Text.Trim(Text.From([ListeEquipements]{1})) otherwise null,
        type text
    ),

    SuppressionListeEquipements = Table.RemoveColumns(
        AjoutRITM,
        {"ListeEquipements"}
    )
in
    SuppressionListeEquipements
