let
    Source = #"lecomptoir allvisits_181124",

    // ============================================================
    // 1. Conservation uniquement des colonnes utiles
    // ============================================================
    ColonnesUtiles = Table.SelectColumns(
        Source,
        {
            "_id",
            "createdAt_local",
            "cdspp_ritmlist"
        },
        MissingField.Ignore
    ),

    // ============================================================
    // 2. Création de la liste des équipements
    //
    // ; = séparateur entre plusieurs équipements
    //
    // Format récent :
    // Workstation,RITM001;Accessory,RITM002
    //
    // Format ancien :
    // RITM001;RITM002
    // ============================================================
    AjoutListeEquipements = Table.AddColumn(
        ColonnesUtiles,
        "ListeEquipements",
        each
            let
                ValeurSource =
                    try Text.From([cdspp_ritmlist])
                    otherwise null
            in
                if ValeurSource = null then
                    {}
                else if Text.Trim(ValeurSource) = "" then
                    {}
                else
                    Text.Split(
                        ValeurSource,
                        ";"
                    )
    ),

    // ============================================================
    // 3. Une ligne par équipement
    // ============================================================
    DevelopperListeEquipements = Table.ExpandListColumn(
        AjoutListeEquipements,
        "ListeEquipements"
    ),

    // ============================================================
    // 4. Extraction du type d'équipement
    //
    // Workstation,RITM001 -> Workstation
    //
    // RITM001 -> null
    // ============================================================
    AjoutTypeEquipement = Table.AddColumn(
        DevelopperListeEquipements,
        "TypeEquipement",
        each
            let
                Valeur =
                    try Text.Trim(
                        Text.From([ListeEquipements])
                    )
                    otherwise null
            in
                if Valeur = null then
                    null
                else if Valeur = "" then
                    null
                else if Text.Contains(Valeur, ",") then
                    Text.Trim(
                        Text.BeforeDelimiter(
                            Valeur,
                            ","
                        )
                    )
                else
                    null,
        type text
    ),

    // ============================================================
    // 5. Extraction du RITM
    //
    // Format récent :
    // Workstation,RITM001 -> RITM001
    //
    // Format ancien :
    // RITM001 -> RITM001
    // ============================================================
    AjoutRITM = Table.AddColumn(
        AjoutTypeEquipement,
        "RITM",
        each
            let
                Valeur =
                    try Text.Trim(
                        Text.From([ListeEquipements])
                    )
                    otherwise null
            in
                if Valeur = null then
                    null
                else if Valeur = "" then
                    null
                else if Text.Contains(Valeur, ",") then
                    Text.Trim(
                        Text.AfterDelimiter(
                            Valeur,
                            ","
                        )
                    )
                else if Text.StartsWith(
                    Text.Upper(Valeur),
                    "RITM"
                ) then
                    Valeur
                else
                    null,
        type text
    ),

    // ============================================================
    // 6. Type utilisé dans les graphiques
    //
    // Règles :
    //
    // RITM null + Type null
    // -> null
    //
    // RITM renseigné + Type null
    // -> "Non renseigné"
    //
    // RITM renseigné + Type renseigné
    // -> Type réel
    // ============================================================
    AjoutTypeEquipementAffiche = Table.AddColumn(
        AjoutRITM,
        "TypeEquipementAffiche",
        each
            let
                Type =
                    try Text.Trim(
                        Text.From([TypeEquipement])
                    )
                    otherwise null,

                Ritm =
                    try Text.Trim(
                        Text.From([RITM])
                    )
                    otherwise null
            in
                if Ritm = null or Ritm = "" then
                    null
                else if Type = null or Type = "" then
                    "Non renseigné"
                else
                    Type,
        type text
    ),

    // ============================================================
    // 7. Suppression des colonnes techniques devenues inutiles
    // ============================================================
    SuppressionColonnesTechniques = Table.RemoveColumns(
        AjoutTypeEquipementAffiche,
        {
            "ListeEquipements",
            "cdspp_ritmlist"
        }
    )

in
    SuppressionColonnesTechniques
