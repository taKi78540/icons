## 3. Code Power Query M

Version actuellement retenue : **sans filtre initial**, afin d’éviter les temps de traitement trop longs pendant la phase de construction.

```powerquery
let
    // Requête source principale
    Source = #"lecomptoir allvisits_181124",

    // Création d'une liste d'équipements.
    // Si cdspp_ritmlist est vide ou null, on crée une liste vide.
    // Sinon, on découpe la chaîne sur le point-virgule.
    //
    // Exemple :
    // Workstation,RITM001;Display Device,RITM002
    //
    // devient :
    // Workstation,RITM001
    // Display Device,RITM002
    AjoutListeEquipements = Table.AddColumn(
        Source,
        "ListeEquipements",
        each
            if [cdspp_ritmlist] = null
                or Text.Trim(Text.From([cdspp_ritmlist])) = ""
            then
                {}
            else
                Text.Split(
                    Text.From([cdspp_ritmlist]),
                    ";"
                )
    ),

    // Chaque élément de la liste devient une ligne distincte.
    //
    // Une visite contenant 3 équipements génère donc 3 lignes.
    DevelopperListeEquipements = Table.ExpandListColumn(
        AjoutListeEquipements,
        "ListeEquipements"
    ),

    // Extraction du type d'équipement.
    // On récupère la partie située avant la virgule.
    //
    // Exemple :
    // Workstation,RITM001
    // devient :
    // Workstation
    AjoutTypeEquipement = Table.AddColumn(
        DevelopperListeEquipements,
        "TypeEquipement",
        each
            try
                Text.Trim(
                    Text.BeforeDelimiter(
                        Text.From([ListeEquipements]),
                        ","
                    )
                )
            otherwise
                null,
        type text
    ),

    // Extraction du RITM.
    // On récupère la partie située après la virgule.
    //
    // Exemple :
    // Workstation,RITM001
    // devient :
    // RITM001
    AjoutRITM = Table.AddColumn(
        AjoutTypeEquipement,
        "RITM",
        each
            try
                Text.Trim(
                    Text.AfterDelimiter(
                        Text.From([ListeEquipements]),
                        ","
                    )
                )
            otherwise
                null,
        type text
    ),

    // Suppression de la colonne intermédiaire devenue inutile.
    SuppressionListeEquipements = Table.RemoveColumns(
        AjoutRITM,
        {
            "ListeEquipements"
        }
    )

in
    SuppressionListeEquipements
```

