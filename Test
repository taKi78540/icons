# 3. Création de la requête `EquipementsRestitues`

Dans Power Query :

1. Clic droit sur la requête :

```text
lecomptoir allvisits_181124
```

2. Choisir :

```text
Référence
```

3. Renommer la nouvelle requête :

```text
EquipementsRestitues
```

4. Ouvrir :

```text
Accueil > Éditeur avancé
```

5. Remplacer tout le contenu par le code suivant.

---

# 4. Code Power Query M

```powerquery
let
    // Requête source principale
    Source = #"lecomptoir allvisits_181124",

    // Création d'une liste d'équipements.
    //
    // Si cdspp_ritmlist est vide ou null,
    // on crée une liste vide.
    //
    // Sinon, on découpe la chaîne sur le point-virgule.
    //
    // Format récent :
    // Workstation,RITM001;Accessory,RITM002
    //
    // Ancien format :
    // RITM001;RITM002;RITM003
    AjoutListeEquipements = Table.AddColumn(
        Source,
        "ListeEquipements",
        each
            if [cdspp_ritmlist] = null
                or Text.Trim(Text.From([cdspp_ritmlist])) = ""
            then
                {}
            else
                Text.Split(
                    Text.From([cdspp_ritmlist]),
                    ";"
                )
    ),

    // Une ligne par équipement
    DevelopperListeEquipements = Table.ExpandListColumn(
        AjoutListeEquipements,
        "ListeEquipements"
    ),

    // Extraction du type d'équipement.
    //
    // Si une virgule existe :
    // Workstation,RITM001 -> Workstation
    //
    // Si aucune virgule n'existe :
    // RITM001 -> null
    AjoutTypeEquipement = Table.AddColumn(
        DevelopperListeEquipements,
        "TypeEquipement",
        each
            let
                Valeur = Text.Trim(
                    Text.From([ListeEquipements])
                )
            in
                if Text.Contains(Valeur, ",") then
                    Text.Trim(
                        Text.BeforeDelimiter(
                            Valeur,
                            ","
                        )
                    )
                else
                    null,
        type text
    ),

    // Extraction du RITM.
    //
    // Format récent :
    // Workstation,RITM001 -> RITM001
    //
    // Ancien format :
    // RITM001 -> RITM001
    AjoutRITM = Table.AddColumn(
        AjoutTypeEquipement,
        "RITM",
        each
            let
                Valeur = Text.Trim(
                    Text.From([ListeEquipements])
                )
            in
                if Text.Contains(Valeur, ",") then
                    Text.Trim(
                        Text.AfterDelimiter(
                            Valeur,
                            ","
                        )
                    )
                else if Text.StartsWith(
                    Text.Upper(Valeur),
                    "RITM"
                ) then
                    Valeur
                else
                    null,
        type text
    ),

    // Création d'un type d'équipement utilisable dans les graphiques.
    //
    // Si le type est absent dans les anciennes données,
    // on affiche "Non renseigné".
    AjoutTypeEquipementAffiche = Table.AddColumn(
        AjoutRITM,
        "TypeEquipementAffiche",
        each
            if [TypeEquipement] = null
                or Text.Trim(
                    Text.From([TypeEquipement])
                ) = ""
            then
                "Non renseigné"
            else
                Text.Trim(
                    Text.From([TypeEquipement])
                ),
        type text
    ),

    // Suppression de la colonne technique intermédiaire
    SuppressionListeEquipements = Table.RemoveColumns(
        AjoutTypeEquipementAffiche,
        {
            "ListeEquipements"
        }
    )

in
    SuppressionListeEquipements
```

