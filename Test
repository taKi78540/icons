
Time Saved Return (Display) =
VAR TotalHours = [Time Saved Return (hours)]
VAR TotalMinutes = ROUND(ABS(TotalHours) * 60, 0)
VAR Hours = QUOTIENT(TotalMinutes, 60)
VAR Minutes = MOD(TotalMinutes, 60)
VAR SignValue = IF(TotalHours < 0, "-", "")

RETURN
IF(
    ISBLANK(TotalHours),
    BLANK(),
    SignValue &
    IF(
        Hours = 0,
        FORMAT(Minutes, "0") & " min",
        FORMAT(Hours, "0") & " h " &
        FORMAT(Minutes, "0") & " min"
    )
)
