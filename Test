
Time Saved Return (hours) =
VAR GainTotalMinutes =
    SUMX(
        VALUES('lecomptoir allvisits_181124'[comptoirId]),

        VAR TempsMoyenAncien =
            CALCULATE([AVG Old Return Last 300])

        VAR NbNouvellesRestitutions =
            CALCULATE(
                COUNTROWS('lecomptoir allvisits_181124'),
                'lecomptoir allvisits_181124'[Processus restitution] = "New process",
                'lecomptoir allvisits_181124'[processingTime] > 0
            )

        VAR TempsReelNouveau =
            CALCULATE(
                SUM('lecomptoir allvisits_181124'[processingTime]),
                'lecomptoir allvisits_181124'[Processus restitution] = "New process",
                'lecomptoir allvisits_181124'[processingTime] > 0
            ) / 60000

        RETURN
            IF(
                NbNouvellesRestitutions > 0
                    && NOT ISBLANK(TempsMoyenAncien),
                (TempsMoyenAncien * NbNouvellesRestitutions)
                    - TempsReelNouveau
            )
    )

RETURN
    DIVIDE(GainTotalMinutes, 60)
