let
    Source = #"lecomptoir allvisits_181124",

    // ============================================================
    // 1. On ne garde que les colonnes utiles
    // ============================================================
    ColonnesUtiles = Table.SelectColumns(
        Source,
        {
            "_id",
            "createdAt_local",
            "cdspp_ritmlist"
        },
        MissingField.Ignore
    ),

    // ============================================================
    // 2. Suppression des lignes sans donnée de restitution
    // ============================================================
    LignesAvecRITM = Table.SelectRows(
        ColonnesUtiles,
        each
            [cdspp_ritmlist] <> null
            and Text.Trim(
                Text.From([cdspp_ritmlist])
            ) <> ""
    ),

    // ============================================================
    // 3. Découpage des différents équipements
    // ; = séparateur entre plusieurs équipements
    // ============================================================
    AjoutListeEquipements = Table.AddColumn(
        LignesAvecRITM,
        "ListeEquipements",
        each
            Text.Split(
                Text.From([cdspp_ritmlist]),
                ";"
            )
    ),

    // ============================================================
    // 4. Une ligne par équipement
    // ============================================================
    DevelopperListeEquipements = Table.ExpandListColumn(
        AjoutListeEquipements,
        "ListeEquipements"
    ),

    // ============================================================
    // 5. Extraction du type d'équipement
    //
    // Workstation,RITM001 -> Workstation
    // RITM001             -> null
    // ============================================================
    AjoutTypeEquipement = Table.AddColumn(
        DevelopperListeEquipements,
        "TypeEquipement",
        each
            let
                Valeur =
                    try Text.Trim(
                        Text.From([ListeEquipements])
                    )
                    otherwise null
            in
                if Valeur = null then
                    null
                else if Valeur = "" then
                    null
                else if Text.Contains(Valeur, ",") then
                    Text.Trim(
                        Text.BeforeDelimiter(
                            Valeur,
                            ","
                        )
                    )
                else
                    null,
        type text
    ),

    // ============================================================
    // 6. Extraction du RITM
    //
    // Workstation,RITM001 -> RITM001
    // RITM001             -> RITM001
    // ============================================================
    AjoutRITM = Table.AddColumn(
        AjoutTypeEquipement,
        "RITM",
        each
            let
                Valeur =
                    try Text.Trim(
                        Text.From([ListeEquipements])
                    )
                    otherwise null
            in
                if Valeur = null then
                    null
                else if Valeur = "" then
                    null
                else if Text.Contains(Valeur, ",") then
                    Text.Trim(
                        Text.AfterDelimiter(
                            Valeur,
                            ","
                        )
                    )
                else if Text.StartsWith(
                    Text.Upper(Valeur),
                    "RITM"
                ) then
                    Valeur
                else
                    null,
        type text
    ),

    // ============================================================
    // 7. Type affiché dans les graphiques
    // ============================================================
    AjoutTypeEquipementAffiche = Table.AddColumn(
        AjoutRITM,
        "TypeEquipementAffiche",
        each
            let
                Type =
                    try Text.Trim(
                        Text.From([TypeEquipement])
                    )
                    otherwise null
            in
                if Type = null or Type = "" then
                    "Non renseigné"
                else
                    Type,
        type text
    ),

    // ============================================================
    // 8. Suppression des colonnes techniques
    // ============================================================
    SuppressionColonnesTechniques = Table.RemoveColumns(
        AjoutTypeEquipementAffiche,
        {
            "ListeEquipements",
            "cdspp_ritmlist"
        }
    )

in
    SuppressionColonnesTechniques
