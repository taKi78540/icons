let
    Source = #"lecomptoir allvisits_181124",

    // ============================================================
    // 1. Création de la liste des équipements
    //
    // ; = séparateur entre plusieurs équipements
    //
    // Exemple récent :
    // Workstation,RITM001;Accessory,RITM002
    //
    // Exemple ancien :
    // RITM001;RITM002
    // ============================================================
    AjoutListeEquipements = Table.AddColumn(
        Source,
        "ListeEquipements",
        each
            let
                ValeurSource = try Text.From([cdspp_ritmlist]) otherwise null
            in
                if ValeurSource = null then
                    {}
                else if Text.Trim(ValeurSource) = "" then
                    {}
                else
                    Text.Split(
                        ValeurSource,
                        ";"
                    )
    ),

    // ============================================================
    // 2. Une ligne par équipement
    // ============================================================
    DevelopperListeEquipements = Table.ExpandListColumn(
        AjoutListeEquipements,
        "ListeEquipements"
    ),

    // ============================================================
    // 3. Extraction du TypeEquipement
    //
    // Workstation,RITM001 -> Workstation
    //
    // RITM001 -> null
    // car l'ancien format ne contient pas le type
    // ============================================================
    AjoutTypeEquipement = Table.AddColumn(
        DevelopperListeEquipements,
        "TypeEquipement",
        each
            let
                Valeur =
                    try Text.Trim(
                        Text.From([ListeEquipements])
                    )
                    otherwise null
            in
                if Valeur = null then
                    null
                else if Valeur = "" then
                    null
                else if Text.Contains(Valeur, ",") then
                    Text.Trim(
                        Text.BeforeDelimiter(
                            Valeur,
                            ","
                        )
                    )
                else
                    null,
        type text
    ),

    // ============================================================
    // 4. Extraction du RITM
    //
    // Format récent :
    // Workstation,RITM001 -> RITM001
    //
    // Format ancien :
    // RITM001 -> RITM001
    // ============================================================
    AjoutRITM = Table.AddColumn(
        AjoutTypeEquipement,
        "RITM",
        each
            let
                Valeur =
                    try Text.Trim(
                        Text.From([ListeEquipements])
                    )
                    otherwise null
            in
                if Valeur = null then
                    null
                else if Valeur = "" then
                    null
                else if Text.Contains(Valeur, ",") then
                    Text.Trim(
                        Text.AfterDelimiter(
                            Valeur,
                            ","
                        )
                    )
                else if Text.StartsWith(
                    Text.Upper(Valeur),
                    "RITM"
                ) then
                    Valeur
                else
                    null,
        type text
    ),

    // ============================================================
    // 5. Type utilisé dans les graphiques
    //
    // Les anciennes données dont le type n'était pas renseigné
    // apparaissent sous "Non renseigné"
    // ============================================================
    AjoutTypeEquipementAffiche = Table.AddColumn(
        AjoutRITM,
        "TypeEquipementAffiche",
        each
            let
                Type =
                    try Text.Trim(
                        Text.From([TypeEquipement])
                    )
                    otherwise null
            in
                if Type = null then
                    "Non renseigné"
                else if Type = "" then
                    "Non renseigné"
                else
                    Type,
        type text
    ),

    // ============================================================
    // 6. Suppression de la colonne technique intermédiaire
    // ============================================================
    SuppressionListeEquipements = Table.RemoveColumns(
        AjoutTypeEquipementAffiche,
        {
            "ListeEquipements"
        }
    )

in
    SuppressionListeEquipements
