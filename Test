let
    Source = #"lecomptoir allvisits_181124",

    // Découpe les équipements sur le point-virgule.
    //
    // Format récent :
    // Workstation,RITM001;Accessory,RITM002
    //
    // Ancien format possible :
    // RITM001;RITM002;RITM003
    AjoutListeEquipements = Table.AddColumn(
        Source,
        "ListeEquipements",
        each
            if [cdspp_ritmlist] = null
                or Text.Trim(Text.From([cdspp_ritmlist])) = ""
            then
                {}
            else
                Text.Split(
                    Text.From([cdspp_ritmlist]),
                    ";"
                )
    ),

    // Une ligne par équipement
    DevelopperListeEquipements = Table.ExpandListColumn(
        AjoutListeEquipements,
        "ListeEquipements"
    ),

    // Type d'équipement :
    //
    // Si une virgule existe :
    // Workstation,RITM001 -> Workstation
    //
    // Si aucune virgule n'existe et que la valeur est directement un RITM :
    // RITM001 -> null
    AjoutTypeEquipement = Table.AddColumn(
        DevelopperListeEquipements,
        "TypeEquipement",
        each
            let
                Valeur = Text.Trim(Text.From([ListeEquipements]))
            in
                if Text.Contains(Valeur, ",") then
                    Text.Trim(
                        Text.BeforeDelimiter(
                            Valeur,
                            ","
                        )
                    )
                else
                    null,
        type text
    ),

    // RITM :
    //
    // Format récent :
    // Workstation,RITM001 -> RITM001
    //
    // Ancien format :
    // RITM001 -> RITM001
    AjoutRITM = Table.AddColumn(
        AjoutTypeEquipement,
        "RITM",
        each
            let
                Valeur = Text.Trim(Text.From([ListeEquipements]))
            in
                if Text.Contains(Valeur, ",") then
                    Text.Trim(
                        Text.AfterDelimiter(
                            Valeur,
                            ","
                        )
                    )
                else if Text.StartsWith(
                    Text.Upper(Valeur),
                    "RITM"
                ) then
                    Valeur
                else
                    null,
        type text
    ),

    // Suppression de la colonne intermédiaire
    SuppressionListeEquipements = Table.RemoveColumns(
        AjoutRITM,
        {
            "ListeEquipements"
        }
    )

in
    SuppressionListeEquipements
