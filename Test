
AVG Old Return Last 300 =
VAR Dernieres300 =
    CALCULATETABLE(
        TOPN(
            300,
            FILTER(
                'lecomptoir allvisits_181124',
                'lecomptoir allvisits_181124'[Processus restitution] = "Old process"
                    && 'lecomptoir allvisits_181124'[processingTime] > 0
            ),
            'lecomptoir allvisits_181124'[createdAt], DESC,
            'lecomptoir allvisits_181124'[_id], DESC
        ),
        REMOVEFILTERS('TableDate'),
        REMOVEFILTERS('lecomptoir allvisits_181124'[createdAt]),
        REMOVEFILTERS('lecomptoir allvisits_181124'[createdAt_local]),
        REMOVEFILTERS('lecomptoir allvisits_181124'[Processus restitution])
    )
RETURN
    DIVIDE(
        AVERAGEX(
            Dernieres300,
            'lecomptoir allvisits_181124'[processingTime]
        ),
        60000
    )
