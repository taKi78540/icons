# 5. Code Power Query M

Version retenue :

- pas de filtre Power Query sur les lignes nulles
- conservation des lignes nulles pour éviter les temps de traitement trop longs
- filtrage logique effectué ensuite en DAX via le champ `RITM`

```powerquery
let
    Source = #"lecomptoir allvisits_181124",

    // ============================================================
    // 1. On ne conserve que les colonnes nécessaires au rapport
    // ============================================================
    ColonnesUtiles = Table.SelectColumns(
        Source,
        {
            "_id",
            "createdAt_local",
            "cdspp_ritmlist"
        },
        MissingField.Ignore
    ),

    // ============================================================
    // 2. Création d'une liste d'équipements
    //
    // Format récent :
    // Workstation,RITM001;Accessory,RITM002
    //
    // Format ancien :
    // RITM001;RITM002
    //
    // Le point-virgule sépare les équipements
    // ============================================================
    AjoutListeEquipements = Table.AddColumn(
        ColonnesUtiles,
        "ListeEquipements",
        each
            let
                ValeurSource =
                    try Text.From([cdspp_ritmlist])
                    otherwise null
            in
                if ValeurSource = null then
                    {}
                else if Text.Trim(ValeurSource) = "" then
                    {}
                else
                    Text.Split(
                        ValeurSource,
                        ";"
                    )
    ),

    // ============================================================
    // 3. Une ligne par équipement
    // ============================================================
    DevelopperListeEquipements = Table.ExpandListColumn(
        AjoutListeEquipements,
        "ListeEquipements"
    ),

    // ============================================================
    // 4. Extraction du type d'équipement
    //
    // Workstation,RITM001 -> Workstation
    //
    // RITM001 -> null
    // ============================================================
    AjoutTypeEquipement = Table.AddColumn(
        DevelopperListeEquipements,
        "TypeEquipement",
        each
            let
                Valeur =
                    try Text.Trim(
                        Text.From([ListeEquipements])
                    )
                    otherwise null
            in
                if Valeur = null then
                    null
                else if Valeur = "" then
                    null
                else if Text.Contains(Valeur, ",") then
                    Text.Trim(
                        Text.BeforeDelimiter(
                            Valeur,
                            ","
                        )
                    )
                else
                    null,
        type text
    ),

    // ============================================================
    // 5. Extraction du RITM
    //
    // Format récent :
    // Workstation,RITM001 -> RITM001
    //
    // Format ancien :
    // RITM001 -> RITM001
    // ============================================================
    AjoutRITM = Table.AddColumn(
        AjoutTypeEquipement,
        "RITM",
        each
            let
                Valeur =
                    try Text.Trim(
                        Text.From([ListeEquipements])
                    )
                    otherwise null
            in
                if Valeur = null then
                    null
                else if Valeur = "" then
                    null
                else if Text.Contains(Valeur, ",") then
                    Text.Trim(
                        Text.AfterDelimiter(
                            Valeur,
                            ","
                        )
                    )
                else if Text.StartsWith(
                    Text.Upper(Valeur),
                    "RITM"
                ) then
                    Valeur
                else
                    null,
        type text
    ),

    // ============================================================
    // 6. Type utilisé dans les graphiques
    //
    // RITM null + Type null
    // -> null
    //
    // RITM renseigné + Type null
    // -> "Non renseigné"
    //
    // RITM renseigné + Type renseigné
    // -> Type réel
    // ============================================================
    AjoutTypeEquipementAffiche = Table.AddColumn(
        AjoutRITM,
        "TypeEquipementAffiche",
        each
            let
                Type =
                    try Text.Trim(
                        Text.From([TypeEquipement])
                    )
                    otherwise null,

                Ritm =
                    try Text.Trim(
                        Text.From([RITM])
                    )
                    otherwise null
            in
                if Ritm = null or Ritm = "" then
                    null
                else if Type = null or Type = "" then
                    "Non renseigné"
                else
                    Type,
        type text
    ),

    // ============================================================
    // 7. Suppression des colonnes techniques
    // ============================================================
    SuppressionColonnesTechniques = Table.RemoveColumns(
        AjoutTypeEquipementAffiche,
        {
            "ListeEquipements",
            "cdspp_ritmlist"
        }
    )

in
    SuppressionColonnesTechniques
```

